#!/bin/sh
# Herramientas opcionales: si alguna no existe en el repo, se salta sin romper el build.
export DEBIAN_FRONTEND=noninteractive
for pkg in ncat ffuf gobuster masscan nikto wfuzz dirb reaver steghide hashid \
           radare2 seclists exploitdb fastfetch netdiscover enum4linux smbclient; do
  apt-get install -y --no-install-recommends "$pkg" >/dev/null 2>&1 \
    && echo "[kirksOeS] instalado: $pkg" || echo "[kirksOeS] no disponible: $pkg"
done
apt-get clean
