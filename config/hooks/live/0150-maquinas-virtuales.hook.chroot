#!/bin/sh
# Soporte para máquinas virtuales (VirtualBox, VMware, QEMU/KVM).
# Solo se usan repos oficiales de Debian; nada que pueda romper apt.
# Si un paquete no está, se salta sin tumbar el build.
export DEBIAN_FRONTEND=noninteractive

# Agentes de integración que están en Debian main/contrib.
# Los drivers de video (VMSVGA / QXL / vboxvideo) hacen que la pantalla
# se vea bien en la VM. Para VirtualBox, los módulos vboxguest/vboxvideo
# ya vienen dentro del kernel de Debian (linux-image-amd64).
for pkg in open-vm-tools open-vm-tools-desktop spice-vdagent qemu-guest-agent \
           xserver-xorg-video-vmware xserver-xorg-video-qxl \
           virtualbox-guest-x11 virtualbox-guest-utils; do
  apt-get install -y --no-install-recommends "$pkg" >/dev/null 2>&1 \
    && echo "[kirksOeS] instalado: $pkg" || echo "[kirksOeS] no disponible: $pkg"
done

apt-get clean
